{
 "version": 1,
 "levels": {
  "hook-exec": 2,
  "config-pipe-shell": 2,
  "encoded-exec": 2,
  "reverse-shell": 2,
  "stealer": 2,
  "inject-stealth-exfil": 2,
  "hidden-text": 2,
  "clone-cluster": 2,
  "hook-net": 1,
  "pipe-shell": 1,
  "ps-download-exec": 1,
  "cred-read": 1,
  "exfil-chan": 1,
  "miner": 1,
  "secret-leak": 1,
  "inject-override": 1,
  "inject-secrecy": 1,
  "inject-exfil": 1,
  "bidi-control": 1,
  "zero-width": 1,
  "setup-net": 1,
  "obfuscated": 1,
  "tree-exe": 1,
  "tree-env": 1,
  "tree-key": 1,
  "tree-dump": 1,
  "meta-abuse": 1
 },
 "files": [
  {
   "cls": "pkg",
   "re": "^(package\\.json|setup\\.py)$",
   "max": 2
  },
  {
   "cls": "config",
   "re": "^(\\.claude/settings(\\.local)?\\.json|\\.mcp\\.json|mcp\\.json|\\.claude-plugin/plugin\\.json|hooks/hooks\\.json|\\.cursor/mcp\\.json)$",
   "max": 4
  },
  {
   "cls": "skill",
   "re": "^(claude|agents|gemini)\\.md$|^\\.cursorrules$|^\\.github/copilot-instructions\\.md$",
   "max": 3
  },
  {
   "cls": "skill",
   "re": "(^|/)skill\\.md$",
   "max": 4
  },
  {
   "cls": "skill",
   "re": "^\\.claude/(commands|agents|skills)/.+\\.md$|^\\.cursor/rules/[^/]+\\.mdc?$",
   "max": 3
  },
  {
   "cls": "install",
   "re": "^([^/]+/)?(install|setup|bootstrap|postinstall|preinstall)[\\w.-]*\\.(sh|bash|ps1|js|cjs|mjs|py)$",
   "max": 3
  },
  {
   "cls": "code",
   "re": "^(src/)?(index|main|cli|server|app)\\.(js|mjs|cjs|ts|py)$",
   "max": 3
  },
  {
   "cls": "code",
   "re": "^(scripts|hooks|bin)/[^/]+\\.(sh|py|js|mjs)$",
   "max": 3
  }
 ],
 "maxFiles": 14,
 "maxBytes": 200000,
 "maxFileSize": 400000,
 "content": [
  {
   "code": "pipe-shell",
   "in": [
    "skill",
    "pkg"
   ],
   "flags": "i",
   "re": "\\b(curl|wget)\\b(?![^\\n|]{0,200}(sh\\.rustup\\.rs|astral\\.sh|bun\\.sh|get\\.docker\\.com|deno\\.land|ollama\\.com|get\\.pnpm\\.io|install\\.python-poetry\\.org|fnm\\.vercel\\.app|claude\\.ai/install|mise\\.run|brew\\.sh|Homebrew/install|nvm-sh/nvm|get\\.helm\\.sh|tailscale\\.com/install))[^\\n|;&]{0,200}\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b"
  },
  {
   "code": "config-pipe-shell",
   "in": [
    "config"
   ],
   "flags": "i",
   "re": "\\b(curl|wget)\\b[^\\n|;&]{0,200}\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b"
  },
  {
   "code": "ps-download-exec",
   "in": [
    "skill",
    "pkg",
    "config"
   ],
   "flags": "i",
   "re": "\\b(iwr|irm|invoke-webrequest|invoke-restmethod|downloadstring|downloadfile)\\b(?![^\\n|]{0,200}(sh\\.rustup\\.rs|astral\\.sh|bun\\.sh|get\\.docker\\.com|deno\\.land|ollama\\.com|get\\.pnpm\\.io|install\\.python-poetry\\.org|fnm\\.vercel\\.app|claude\\.ai/install|mise\\.run|brew\\.sh|Homebrew/install|nvm-sh/nvm|get\\.helm\\.sh|tailscale\\.com/install))[^\\n]{0,200}\\b(iex|invoke-expression|start-process)\\b|\\biex\\s*\\(\\s*\\(?\\s*(iwr|irm|new-object)\\b"
  },
  {
   "code": "encoded-exec",
   "in": [
    "pkg",
    "install",
    "skill",
    "code",
    "config"
   ],
   "flags": "i",
   "re": "\\beval\\s*\\(\\s*(atob|unescape)\\s*\\(|\\beval\\s*\\(\\s*Buffer\\.from\\s*\\([^)\\n]{0,400}base64|\\bnew\\s+Function\\s*\\(\\s*atob\\s*\\("
  },
  {
   "code": "encoded-exec",
   "in": [
    "pkg",
    "install",
    "skill",
    "code",
    "config"
   ],
   "flags": "i",
   "re": "\\bexec\\s*\\(\\s*(base64\\.b64decode|zlib\\.decompress|marshal\\.loads|bytes\\.fromhex|codecs\\.decode|compile\\s*\\(\\s*(base64|zlib|marshal)\\.|__import__\\s*\\(\\s*['\\\"](base64|zlib|marshal)['\\\"]\\s*\\))"
  },
  {
   "code": "encoded-exec",
   "in": [
    "pkg",
    "install",
    "skill",
    "code",
    "config"
   ],
   "flags": "i",
   "re": "\\bbase64\\s+(-d|--decode)\\b[^\\n|]{0,120}\\|\\s*(sudo\\s+)?(ba|z)?sh\\b"
  },
  {
   "code": "reverse-shell",
   "in": [
    "pkg",
    "install",
    "skill",
    "code",
    "config"
   ],
   "flags": "i",
   "re": "\\b(ba)?sh\\s+-i\\b[^\\n]{0,80}/dev/(tcp|udp)/|/dev/(tcp|udp)/\\S+\\s+0>&1|\\bnc(at)?\\s+(-\\w+\\s+){0,3}-e\\s+/bin/(ba)?sh\\b|\\bexec\\s+\\d+<>\\s*/dev/tcp/(?!127\\.|localhost)[\\w.-]+/\\d+"
  },
  {
   "code": "cred-read",
   "in": [
    "pkg",
    "install",
    "code",
    "config"
   ],
   "flags": "i",
   "re": "\\.ssh/id_(rsa|ed25519|ecdsa|dsa)(?!\\.pub)\\b|\\.aws/credentials\\b|\\bwallet\\.dat\\b|/Login Data\\b|\\.git-credentials\\b|\\.docker/config\\.json|\\.config/gcloud/(credentials|application_default)|Library/Keychains"
  },
  {
   "code": "exfil-chan",
   "in": [
    "pkg",
    "install",
    "skill",
    "code",
    "config"
   ],
   "flags": "i",
   "re": "discord(app)?\\.com/api/webhooks/\\d+/[\\w-]{20,}|api\\.telegram\\.org/bot\\d{6,}:[\\w-]{20,}|webhook\\.site/[\\w-]{8,}|\\b[\\w-]+\\.requestcatcher\\.com|\\b[\\w-]+\\.m\\.pipedream\\.net|\\binteract\\.sh\\b|burpcollaborator\\.net|transfer\\.sh/|pastebin\\.com/raw/|\\b[\\w-]+\\.ngrok(-free)?\\.(io|app|dev)\\b"
  },
  {
   "code": "miner",
   "in": [
    "pkg",
    "install",
    "code",
    "config"
   ],
   "flags": "i",
   "re": "stratum\\+(tcp|ssl)://|\\bxmrig\\b|\\bcoinhive\\b|\\bcryptonight\\b|--donate-level\\b"
  },
  {
   "code": "secret-leak",
   "in": [
    "pkg",
    "install",
    "skill",
    "code",
    "config"
   ],
   "flags": "",
   "re": "\\bAKIA(?!IOSFODNN7EXAMPLE)[0-9A-Z]{16}\\b|-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----|\\bghp_[A-Za-z0-9]{36}\\b|\\bgithub_pat_[A-Za-z0-9_]{50,}|\\bsk-ant-[A-Za-z0-9_-]{40,}|\\bxox[bap]-[0-9A-Za-z-]{24,}|\\bAIza[0-9A-Za-z_-]{35}\\b|\\bsk_live_[0-9A-Za-z]{20,}"
  },
  {
   "code": "inject-override",
   "in": [
    "skill"
   ],
   "flags": "i",
   "re": "\\b(ignore|disregard|forget|override)\\s+(all\\s+|any\\s+|the\\s+|your\\s+)?(previous|prior|above|earlier|preceding|system|original)\\s+(instructions?|prompts?|rules|guidelines|directives)\\b"
  },
  {
   "code": "inject-secrecy",
   "in": [
    "skill"
   ],
   "flags": "i",
   "re": "\\b(do\\s+not|don't|never)\\s+(tell|inform|mention|reveal|disclose|notify|alert)\\b[^\\n.]{0,30}\\bthe\\s+user\\b|\\bwithout\\s+(telling|informing|notifying|alerting)\\s+the\\s+user\\b|\\b(hide|conceal)\\s+(this|it|these|that)\\s+from\\s+the\\s+user\\b"
  },
  {
   "code": "inject-exfil",
   "in": [
    "skill",
    "config"
   ],
   "flags": "i",
   "re": "\\b(send|post|upload|forward|exfiltrate|transmit|email)\\b[^\\n]{0,100}\\b(api[ _-]?keys?|access[ _-]?tokens?|passwords?|credentials|secrets|\\.env|ssh[ _-]?keys?|private[ _-]?keys?|session[ _-]?cookies?|environment\\s+variables)\\b[^\\n]{0,100}\\b(to|at|via)\\s+(https?://|[\\w.+-]+@[\\w-]+\\.[\\w.-]+)"
  },
  {
   "code": "setup-net",
   "in": [
    "pkg"
   ],
   "path": "^setup\\.py$",
   "flags": "",
   "re": "\\burlopen\\s*\\(|\\brequests\\.(get|post)\\s*\\(|\\bsocket\\.socket\\s*\\(|\\burlretrieve\\s*\\("
  },
  {
   "code": "obfuscated",
   "in": [
    "install",
    "code",
    "pkg"
   ],
   "flags": "",
   "min": 25,
   "re": "\\b_0x[a-f0-9]{4,6}\\b"
  },
  {
   "code": "obfuscated",
   "in": [
    "install",
    "code",
    "pkg"
   ],
   "flags": "",
   "re": "(chr\\(\\d{2,3}\\)\\s*\\+\\s*){6,}"
  }
 ],
 "hookKeys": [
  "preinstall",
  "install",
  "postinstall",
  "prepare"
 ],
 "hookRe": "\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b|\\bbase64\\s+(-d|--decode)\\b|\\b(iex|invoke-expression)\\b|\\batob\\s*\\(|Buffer\\.from\\([^)]{0,200}base64|/dev/tcp/(?!127\\.|localhost)[\\w.-]+/\\d+",
 "hookNetRe": "\\b(curl|wget|powershell|pwsh)\\b|https?://|\\bfetch\\s*\\(|require\\(\\s*['\\\"]https?['\\\"]\\s*\\)",
 "hookScriptRe": "\\b(?:node|sh|bash|python3?)\\s+(\\.?/?[\\w./-]+\\.(?:js|cjs|mjs|sh|py))\\b",
 "combos": [
  {
   "code": "stealer",
   "all": [
    "cred-read",
    "exfil-chan"
   ]
  },
  {
   "code": "inject-stealth-exfil",
   "all": [
    "inject-secrecy",
    "inject-exfil"
   ]
  }
 ],
 "tree": [
  {
   "code": "tree-exe",
   "re": "\\.(exe|scr|pif|msi|vbs|hta|lnk)$"
  },
  {
   "code": "tree-env",
   "re": "^\\.env(\\.local|\\.production|\\.prod)?$"
  },
  {
   "code": "tree-key",
   "re": "(^|/)(id_rsa|id_ed25519|id_ecdsa)$|\\.(p12|pfx|keystore|jks)$|(^|/)service[-_]account[\\w.-]*\\.json$"
  },
  {
   "code": "tree-dump",
   "re": "\\.(sql|sqlite|sqlite3|bak|dump|mdb)$",
   "minSize": 5000000
  }
 ],
 "meta": [
  {
   "code": "meta-abuse",
   "flags": "i",
   "re": "\\b(stealer|keylogger|ransomware|botnet|crypter|aimbot|wallhack|keygen|booter|stresser|token[ -]?grabber|wallet[ -]?drainer|free robux|cracked|phishing (kit|page|template)|ddos (tool|script|attack tool)|hwid (spoofer|bypass)|game cheat|cheat (engine|menu|loader)|account (checker|generator))\\b"
  }
 ],
 "unicode": {
  "tagMin": 10,
  "zeroWidthMin": 20,
  "bidiIn": [
   "skill",
   "code",
   "config",
   "install",
   "pkg"
  ],
  "zeroWidthIn": [
   "skill",
   "config"
  ]
 },
 "fallbackPaths": [
  "package.json",
  "setup.py",
  "SKILL.md",
  "CLAUDE.md",
  "AGENTS.md",
  ".cursorrules",
  ".mcp.json",
  ".claude/settings.json",
  ".claude-plugin/plugin.json",
  "hooks/hooks.json",
  "install.sh",
  "setup.sh",
  "index.js",
  "main.py",
  "src/index.js",
  "src/index.ts"
 ],
 "cluster": {
  "minTokens": 3,
  "jaccard": 0.6,
  "days": 3,
  "starRatio": 0.85,
  "minStars": 30,
  "minSize": 3
 }
}