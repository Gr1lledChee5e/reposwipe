{
  "manifest_version": 3,
  "name": "Skill Swipe — Swipe this repo",
  "short_name": "Skill Swipe",
  "version": "1.1.0",
  "description": "Adds a 'Swipe' button to every GitHub repo page: one click sends the repo into your Skill Swipe Stack. Right-click any GitHub link to swipe it too.",
  "homepage_url": "https://swipe.yeete.ai",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Skill Swipe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}